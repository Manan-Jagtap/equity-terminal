{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "terminal-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 5173,
      "env": { "VITE_API_URL": "https://equity-terminal-backend-production.up.railway.app" }
    },
    {
      "name": "terminal-local",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 5173,
      "env": { "VITE_API_URL": "http://localhost:8000" }
    },
    {
      "name": "terminal-mumbai",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 5173,
      "env": { "VITE_API_URL": "http://localhost:5173", "VITE_DEV_PROXY": "https://api.equityverdict.com" }
    }
  ]
}
